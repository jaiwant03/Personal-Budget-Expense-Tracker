  },
  "homepage": "https://github.com/jaiwant03/Personal-Budget-Expense-Tracker#readme",
  "dependencies": {
    "concurrently": "^10.0.6",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.2.1",
    "mongoose": "^9.11.2"
  }
}
